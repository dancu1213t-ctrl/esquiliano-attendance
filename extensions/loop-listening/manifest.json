{
  "manifest_version": 3,
  "name": "Loop · YouTube Listening",
  "version": "1.0.0",
  "description": "Share your YouTube listening status in Esquiliano Loop while clocked in.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://hunptuwwaxvpigsnrsbl.supabase.co/*",
    "https://www.youtube.com/*",
    "https://music.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Loop Listening"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://music.youtube.com/*"
      ],
      "js": [
        "youtube.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://attendance.esquilianoconsulting.com/*"
      ],
      "js": [
        "connect.js"
      ],
      "run_at": "document_idle"
    }
  ]
}